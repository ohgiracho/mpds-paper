{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MPDS targeted de-leaking blinded Pass 1 pair evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "candidate_scores"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^case_[0-9]{2}__rep_[0-9]{2}$"},
    "candidate_scores": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["alias", "idea_novelty", "mechanistic_originality", "tradeoff_reframing", "cross_perspective_integration", "scientific_correctness", "physical_plausibility", "constraint_adherence", "falsifiability_actionability", "flags", "ihq_rationale", "validity_rationale", "uncertainty_notes"],
        "properties": {
          "alias": {"enum": ["Candidate A", "Candidate B"]},
          "idea_novelty": {"type": "integer", "minimum": 0, "maximum": 5},
          "mechanistic_originality": {"type": "integer", "minimum": 0, "maximum": 5},
          "tradeoff_reframing": {"type": "integer", "minimum": 0, "maximum": 5},
          "cross_perspective_integration": {"type": "integer", "minimum": 0, "maximum": 5},
          "scientific_correctness": {"type": "integer", "minimum": 0, "maximum": 5},
          "physical_plausibility": {"type": "integer", "minimum": 0, "maximum": 5},
          "constraint_adherence": {"type": "integer", "minimum": 0, "maximum": 5},
          "falsifiability_actionability": {"type": "integer", "minimum": 0, "maximum": 5},
          "flags": {
            "type": "object", "additionalProperties": false,
            "required": ["scientifically_consequential_error", "temporal_cutoff_violation", "fixed_task_constraint_violation", "infeasible_primary_process"],
            "properties": {
              "scientifically_consequential_error": {"enum": ["yes", "no", "uncertain"]},
              "temporal_cutoff_violation": {"enum": ["yes", "no", "uncertain"]},
              "fixed_task_constraint_violation": {"enum": ["yes", "no", "uncertain"]},
              "infeasible_primary_process": {"enum": ["yes", "no", "uncertain"]}
            }
          },
          "ihq_rationale": {"type": "string", "minLength": 1},
          "validity_rationale": {"type": "string", "minLength": 1},
          "uncertainty_notes": {"type": "string"}
        }
      }
    }
  }
}
